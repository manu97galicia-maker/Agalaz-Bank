# =============================================================================
#  Sniper Deck  ·  copia esto a .env  ·  NUNCA lo subas a git
# =============================================================================

# --- Dónde está el bot -------------------------------------------------------
# Checkout de https://github.com/manu97galicia-maker/Definitivo_bot en el droplet.
BOT_REPO=/root/Definitivo_bot

# --- Acceso ------------------------------------------------------------------
PANEL_USER=manu
# Genera el hash con:  python -m server.hashpw
# No dejes nunca la contraseña en claro aquí: esto es la puerta de un wallet.
PANEL_PASSWORD_HASH=
# Firma las cookies de sesión. Genera uno con:  openssl rand -hex 32
# Si lo cambias, se cierran todas las sesiones abiertas.
PANEL_SESSION_SECRET=

# --- Red ---------------------------------------------------------------------
# Escucha SOLO en loopback: Caddy hace de puerta con HTTPS. No lo pongas a
# 0.0.0.0 salvo que sepas exactamente lo que estás haciendo.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# Ponlo a false SOLO si accedes por http:// (p.ej. túnel SSH sin TLS).
PANEL_COOKIE_SECURE=true

# --- Chat en lenguaje natural (opcional) -------------------------------------
# Sin esto el panel funciona igual, pero sin el chat.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — sube si quieres que razone más las
# preguntas de estrategia; medium mantiene el panel ágil.
AGENT_EFFORT=medium

# --- Escotilla de emergencia -------------------------------------------------
# Deja esto en false. Con true, el agente puede PROPONER un comando de shell
# arbitrario; nunca lo ejecuta solo, pero es la única herramienta sin límites.
AGENT_ALLOW_SHELL=false

# --- Servicios systemd que el panel puede tocar ------------------------------
# Vacío = autodetecta unidades que empiecen por sniper/pumpbot/definitivo.
# PANEL_ALLOWED_UNITS=sniper-bot.service,sniper-deck.service

# --- Solana (opcional) -------------------------------------------------------
# Por defecto el panel lee el RPC y deriva la dirección del wallet del .env del
# bot, sin tocar nunca la clave privada más que para sacar la pública. Si
# prefieres que ni la lea, pon aquí la dirección a pelo:
# PANEL_WALLET_PUBKEY=
