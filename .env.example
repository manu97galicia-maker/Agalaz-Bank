# =============================================================================
#  Sniper Deck  ·  copia esto a .env  ·  NUNCA lo subas a git
# =============================================================================

# --- Dónde está el bot -------------------------------------------------------
# Checkout de https://github.com/manu97galicia-maker/Definitivo_bot en el droplet.
BOT_REPO=/root/Definitivo_bot

# --- Acceso (multiusuario) ---------------------------------------------------
# Los administradores (Manu, Ricardo…) y sus CARGOS viven en state/users.json,
# fuera del repo. Créalos con:
#   python -m server.users add Manu "Chief Trololo Officer"
#   python -m server.users add Ricardo "Chief Technological Trololo Officer"
# O deja que se siembren en el primer arranque poniendo aquí una contraseña
# (se hashea; nunca se guarda en claro). Manu y Ricardo con esta misma:
PANEL_SEED_PASSWORD=
# PIN corto para entrar rápido desde el móvil (entra como el primer usuario).
# Genera el hash con:  python -m server.hashpw --pin
PANEL_PIN_HASH=
# Firma las cookies de sesión. Genera uno con:  openssl rand -hex 32
# Si lo cambias, se cierran todas las sesiones abiertas.
PANEL_SESSION_SECRET=
# "Recuérdame": cuánto dura la sesión marcándolo (por defecto 30 días).
# PANEL_REMEMBER_TTL=2592000

# --- Face ID / huella (WebAuthn) ---------------------------------------------
# Login por cara/huella. Necesita HTTPS y un DOMINIO (o localhost); NO funciona
# sobre una IP pelada. Deja RP_ID vacío para derivarlo del dominio, o fíjalo:
# PANEL_RP_ID=web-app-datos-franc.vercel.app
PANEL_RP_NAME=AGALAZ BANK

# --- Red ---------------------------------------------------------------------
# Escucha SOLO en loopback: Caddy hace de puerta con HTTPS. No lo pongas a
# 0.0.0.0 salvo que sepas exactamente lo que estás haciendo.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# Ponlo a false SOLO si accedes por http:// (p.ej. túnel SSH sin TLS).
PANEL_COOKIE_SECURE=true

# --- Chat en lenguaje natural (opcional) -------------------------------------
# Sin esto el panel funciona igual, pero sin el chat.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — sube si quieres que razone más las
# preguntas de estrategia; medium mantiene el panel ágil.
AGENT_EFFORT=medium

# --- Escotilla de emergencia -------------------------------------------------
# Deja esto en false. Con true, el agente puede PROPONER un comando de shell
# arbitrario; nunca lo ejecuta solo, pero es la única herramienta sin límites.
AGENT_ALLOW_SHELL=false

# --- Servicios systemd que el panel puede tocar ------------------------------
# Vacío = autodetecta unidades que empiecen por sniper/pumpbot/definitivo.
# PANEL_ALLOWED_UNITS=sniper-bot.service,sniper-deck.service

# --- Solana (lectura) --------------------------------------------------------
# Por defecto el panel lee el RPC y deriva la dirección del wallet del .env del
# bot, sin tocar nunca la clave privada más que para sacar la pública. Si
# prefieres que ni la lea, pon aquí la dirección a pelo:
# PANEL_WALLET_PUBKEY=

# --- Wallet CALIENTE (firma transacciones reales) ⚠ -------------------------
# Con esto en true la web PUEDE MOVER TU DINERO: compra, vende y envía SOL
# firmando con la clave privada del bot. Si comprometen el panel, pueden vaciar
# el wallet. Déjalo en false hasta que quieras operar de verdad desde la web.
PANEL_HOT_WALLET=false
# Por defecto firma con la MISMA clave del bot (SOLANA_PRIVATE_KEY). Pon otra
# aquí si quieres una wallet aparte para operar a mano desde el panel:
# PANEL_WALLET_SECRET=
# Tope de seguridad: SOL máximo por compra desde la web (un dedo resbala…).
PANEL_MAX_BUY_SOL=1.0
# Slippage por defecto (en puntos básicos: 1500 = 15%).
# PANEL_BUY_SLIPPAGE_BPS=1500
# PANEL_SELL_SLIPPAGE_BPS=2500
# Fee de prioridad que Jupiter añade para que la tx entre rápido (lamports).
# PANEL_PRIORITY_FEE_LAMPORTS=2000000
